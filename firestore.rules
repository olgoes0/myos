rules_version = '2';
// Reguły Firestore dla Life OS.
// Każdy zalogowany użytkownik widzi i zmienia WYŁĄCZNIE dane pod swoim identyfikatorem (uid).
// Wszystko inne jest zablokowane.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // === PODGLĄD DLA AGENTÓW ===
    // Dokument shares/{klucz}: każdy, kto zna długi losowy klucz, może TYLKO CZYTAĆ (bez listowania).
    // Zapis i usunięcie tylko właściciel (pole owner = jego uid).
    match /shares/{key} {
      allow get: if true;
      allow create, update: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
