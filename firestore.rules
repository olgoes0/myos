rules_version = '2';
// Reguły Firestore dla Life OS.
// Każdy zalogowany użytkownik widzi i zmienia WYŁĄCZNIE dane pod swoim identyfikatorem (uid).
// Wszystko inne jest zablokowane.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
